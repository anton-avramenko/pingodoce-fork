# Copy this file to server/.env and fill in ONE of the keys.
# server/.env is git-ignored. Never commit real keys.

# Google AI Studio (Gemini) — https://aistudio.google.com/ → Get API key
GOOGLE_API_KEY=
# Optional: Gemini model (default gemini-2.5-flash)
GOOGLE_MODEL=

# …or Anthropic (Claude) — https://platform.claude.com/
ANTHROPIC_API_KEY=

# Only needed when both keys are set: anthropic | google
AI_PROVIDER=

# Browser origins allowed to call /scan, comma-separated.
# Default: https://anton-avramenko.github.io + localhost dev servers. "*" = any.
ALLOWED_ORIGINS=

# Optional shared secret on top of the origin check (Reconhecimento por IA → Token).
# The origin check only stops other websites; a script can still fake an Origin.
PROXY_TOKEN=

# Listen port (default 8787)
PORT=
