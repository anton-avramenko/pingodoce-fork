# Copy this file to server/.env and fill in ONE of the keys.
# server/.env is git-ignored. Never commit real keys.

# Google AI Studio (Gemini) — https://aistudio.google.com/ → Get API key
GOOGLE_API_KEY=
# Optional: Gemini model (default gemini-2.5-flash)
GOOGLE_MODEL=

# …or Anthropic (Claude) — https://platform.claude.com/
ANTHROPIC_API_KEY=

# Only needed when both keys are set: anthropic | google
AI_PROVIDER=

# Shared secret the app must send (Reconhecimento por IA → Token).
# Strongly recommended when exposing the server through ngrok.
PROXY_TOKEN=

# Listen port (default 8787)
PORT=
